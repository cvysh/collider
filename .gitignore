# ---- Data: never commit CERN source data or derived bulk artifacts ----
data/raw/
data/interim/
# Derived bulk data stays out, but the curated event artifacts the web app
# serves are small (512 KB total) and are committed so the frontend runs
# without re-running the pipeline.
data/processed/*
!data/processed/events/
*.root
*.parquet
*.h5
*.hdf5
*.npy
*.npz
# ...except the 352 KB dimuon fixture. It is CC0 ATLAS Open Data and the
# physics oracle cannot run in CI without it.
!tests/fixtures/*.npz

# ---- Model artifacts (tracked by registry, stored in object storage) ----
ml/models/*
!ml/models/.gitkeep
*.pkl
*.joblib
*.onnx
*.pt
*.pth

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
dist/
build/

# ---- Node / Next.js ----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# ---- Env & secrets ----
.env
.env.*
!.env.example

# ---- OS / editor ----
.DS_Store
.vscode/
.idea/

# Visual reference material is for local use only, never committed.
assets/reference/*
!assets/reference/README.md

# Frontend build output (node_modules/.next already covered above)
web/.next/
web/out/
web/next-env.d.ts
